{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Modules'|trans }}{% endblock %}

{% block body_testid %}feature-type-configuration{% endblock %}

{% block content %}
<div class="edit-module" id="module-feature-type">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin/home">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="/admin/configuration">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Features types'|trans({}, 'featuretype.bo.default') }}</li>
        </ol>
    </nav>

    {{ safe_hook('feature-type.configuration-top') }}

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h1 class="h4 mb-0">{{ 'Features types'|trans({}, 'featuretype.bo.default') }}</h1>
            <a class="btn btn-secondary btn-sm" target="_blank" href="https://github.com/thelia-modules/FeatureType/issues" title="{{ 'Help !!!'|trans({}, 'featuretype.bo.default') }}">
                <i class="bi bi-info-circle"></i>
            </a>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <colgroup>
                    <col />
                    <col />
                    <col style="width: 30%" />
                    <col style="width: 25%" />
                    <col style="width: 35%" />
                </colgroup>
                <thead>
                <tr>
                    <th>{{ 'ID'|trans }}</th>
                    <th>{{ 'Slug'|trans({}, 'featuretype.bo.default') }}</th>
                    <th>{{ 'Title'|trans }}</th>
                    <th>{{ 'Used by'|trans({}, 'featuretype.bo.default') }}</th>
                    <th>{{ 'Action'|trans({}, 'featuretype.bo.default') }}</th>
                </tr>
                </thead>
                <tbody>
                {% for featureType in feature_types %}
                    <tr>
                        <td>{{ featureType.id }}</td>
                        <td>{{ featureType.slug }}</td>
                        <td>
                            <strong>{{ featureType.title }}</strong>
                            <br/>
                            {{ featureType.description }}
                        </td>
                        <td>
                            {% for feature in featureType.features %}
                                <a href="{{ path('admin.configuration.features.update', {feature_id: feature.id}) }}">{{ feature.title }}</a>
                                <br/>
                            {% else %}
                                {{ 'No'|trans({}, 'featuretype.bo.default') }}
                            {% endfor %}
                        </td>
                        <td>
                            {{ safe_hook('feature-type.list-action', {feature_type_id: featureType.id}) }}
                            <button class="btn btn-primary btn-sm js-action-copy" data-action="{{ path('feature_type_copy', {id: featureType.id, method: '_copy'}) }}">
                                <i class="bi bi-files"></i>
                                {{ 'Copy action'|trans({}, 'featuretype.bo.default') }}
                            </button>
                            <button class="btn btn-info btn-sm js-action-edit" data-action="{{ path('feature_type_view', {id: featureType.id}) }}">
                                <i class="bi bi-gear"></i>
                                {{ 'Edit action'|trans({}, 'featuretype.bo.default') }}
                            </button>
                            <button class="btn btn-danger btn-sm js-action-delete" data-action="{{ path('feature_type_delete', {id: featureType.id, method: '_delete'}) }}">
                                <i class="bi bi-trash"></i>
                                {{ 'Delete action'|trans({}, 'featuretype.bo.default') }}
                            </button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10">
                            <div class="alert alert-info">
                                {{ 'No feature type in database'|trans({}, 'featuretype.bo.default') }}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                <tr>
                    <td colspan="10" class="text-center">
                        <button type="button" class="btn btn-success js-action-create">
                            <i class="bi bi-plus-lg"></i>
                            {{ 'Create action'|trans({}, 'featuretype.bo.default') }}
                        </button>
                    </td>
                </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="js-form-create-wrapper">
        {% if create_form is defined %}
            {% include '@FeatureTypeModule/backOffice/default-twig/feature-type/include/form-create.html.twig' with {form: create_form, feature_type_id: null} %}
        {% endif %}
    </div>
    <div class="js-form-edit-wrapper">
        {% if update_form is defined %}
            {% include '@FeatureTypeModule/backOffice/default-twig/feature-type/include/form-update.html.twig' with {form: update_form, feature_type_id: feature_type_id} %}
        {% endif %}
    </div>

    <!-- Modal delete -->
    <form method="POST" class="js-form-delete" action="">
        <input type="hidden" name="_token" value="{{ assignToken() }}" />
        <input type="hidden" name="success_url" value="{{ path('feature_type_view_all') }}" />

        <div class="modal fade js-modal-delete" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <strong class="modal-title text-uppercase">{{ 'Delete feature type'|trans({}, 'featuretype.bo.default') }}</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        {{ 'Are you sure you want to delete this feature type ?'|trans({}, 'featuretype.bo.default') }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-lg"></i>
                            {{ 'Close action'|trans({}, 'featuretype.bo.default') }}
                        </button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-check-lg"></i>
                            {{ 'Delete action'|trans({}, 'featuretype.bo.default') }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    {{ safe_hook('feature-type.configuration-bottom') }}
    {{ safe_hook('module.configuration', {modulecode: 'FeatureType'}) }}
</div>
{% endblock %}

{% block scripts_extra %}
    {% include '@FeatureTypeModule/backOffice/default-twig/feature-type/configuration-js.html.twig' %}
    {{ safe_hook('feature-type.configuration-js') }}
{% endblock %}
